<!-- start Simple Custom CSS and JS -->
<script type="text/javascript">
/* Default comment here */

jQuery(document).ready(function( $ ){

	var hash = document.location.hash;
	hashLenght = hash.match(/#(.*?)(.*?)(?=\|)/);

	if( hashLenght ) {

		jQuery('html, body').animate({
			scrollTop: (jQuery(hashLenght[0]).offset().top)
		},500);

	}


  $(".carriers-menu-link").click(function () {
     // _setTab( 2 );
     closeMobile();
  });
  
  $(".technology-menu-link").click(function () {
     // _setTab( 0 );
     closeMobile();
  });
  
  $(".freight-providers-menu-link").click(function () {
     // _setTab( 1 );
     closeMobile();
  });
  
  $(".value-added-services-menu-link").click(function () {
      closeMobile();
  });
  
    $(".contact-menu-link").click(function () {
      closeMobile();
  	});
  
  
  function closeMobile( ){
    
    $(".mobile_menu_bar").trigger("click");
   	$( ".mobile_menu_bar" ).removeClass( "et_divi_100_custom_hamburger_menu__icon--toggled" )
    
  }
 
  function _setTab( tab ){
    
    	// ignore if tab is current state
    	// if( tab === window._tabSelected ){ return false; }
   		
   		// set current tab to window
    	window._tabSelected = tab;
    
        // add click event to tab selected
        switch(tab){
            case 0:
            case 1:
            case 2:
            case 3:
            case 4:
                jQuery('#toogle .et_pb_tab_'+tab+' a').click();
            break;

            default:
                return false;
            break;
        }
    
    	$("html, body").animate({ scrollTop: $('#toogle').offset().top }, 1000);
    
   		// scroll to tabs container
    	_scrollToTabs();
    
    	closeMobile();    
	}

    // scroll to member tabs continer with 50px offset
    function _scrollToTabs(){
        var oTabs = jQuery('#member-tabs');
        if( oTabs.length > 0 ){
            jQuery('html,body').animate({
                scrollTop: (oTabs.offset().top - 50)
            }, 1000);
        }
        return false;
    }

	// set falsey state for tab selected on load
	window._tabSelected = false;
  
  });</script>
<!-- end Simple Custom CSS and JS -->
