# ===========================================
# RIGZ Dashboard - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Odoo ERP Connection ---
ODOO_URL=https://rigz.odoo.com/jsonrpc
ODOO_DB=your_odoo_database
ODOO_USER=your_odoo_email
ODOO_PWD=your_odoo_password

# --- MySQL Database (direct connection on VM) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=runtime
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=data

# --- Auth MySQL Database (can be same as above) ---
AUTH_MYSQL_HOST=127.0.0.1
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_USER=runtime
AUTH_MYSQL_PASSWORD=your_mysql_password
AUTH_MYSQL_DATABASE=data

# --- Session ---
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars
# Set to "true" only if you have HTTPS configured (e.g. via Let's Encrypt)
SESSION_SECURE=false

# --- Server ---
NODE_ENV=production
PORT=5000
